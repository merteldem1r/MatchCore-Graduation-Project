#!/bin/sh
# Checks that a commit message follows Conventional Commits (see docs/rules/git-and-recap.md).
#   type(scope)!: description      scope and ! are optional, header <= 100 characters
# Git runs this automatically on `git commit` once `git config core.hooksPath .githooks` is set.
# CI runs the same script on every push. Usage: commit-msg <file-containing-the-message>

MAX_LENGTH=100
TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"

# First line that is neither a comment (#) nor empty.
header=$(sed -e '/^#/d' -e '/^[[:space:]]*$/d' "$1" | head -n 1)

# Messages generated by git itself are always allowed.
case "$header" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

if ! printf '%s\n' "$header" | grep -Eq "^($TYPES)(\([a-z0-9-]+\))?!?: [^ ]"; then
  echo "Error: Commit message does not follow the format:  type(scope): description"
  echo "  got:     $header"
  echo "  types:   $TYPES"
  echo "  example: docs: add step 04 on latency"
  echo "           feat(engine): add limit order matching"
  exit 1
fi

if [ "${#header}" -gt "$MAX_LENGTH" ]; then
  echo "Error: Commit message header is ${#header} characters; the limit is $MAX_LENGTH."
  echo "  got: $header"
  exit 1
fi
